// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doc-middleware > matches snapshot 1`] = `
{
  "info": {
    "description": "Documentation lives next to each handler through \`doc()\` middleware.

Works:

- inline summaries
- markdown descriptions
- operation tags
- deprecated endpoints",
    "title": "Doc Middleware",
    "version": "1.0.0",
  },
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns the current status of the **API service**.

This description is markdown supplied by doc().",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string",
                    },
                    "timestamp": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                    "timestamp",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success response",
          },
        },
        "summary": "Health check endpoint",
        "tags": [
          "Health",
          "Monitoring",
        ],
      },
    },
    "/legacy": {
      "get": {
        "deprecated": true,
        "description": "This endpoint is **deprecated** and will be
removed in v2.0.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success response",
          },
        },
        "summary": "Legacy endpoint",
        "tags": [
          "Legacy",
        ],
      },
    },
    "/users": {
      "get": {
        "description": "Retrieve a paginated list of users with
optional filtering.

This is a compact example of markdown
coming from doc() middleware.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "total": {
                      "type": "number",
                    },
                    "users": {
                      "items": {
                        "additionalProperties": true,
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "users",
                    "total",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success response",
          },
        },
        "summary": "List all users",
        "tags": [
          "Users",
        ],
      },
      "post": {
        "description": "Create a new user account with the provided data.

Required fields:

- name
- email",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "type": "string",
                    },
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success response",
          },
        },
        "summary": "Create new user",
        "tags": [
          "Users",
          "Admin",
        ],
      },
    },
    "/users/{id}": {
      "get": {
        "description": "## Retrieve user details

Retrieve detailed information about a
specific user by their unique ID.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "email": {
                      "type": "string",
                    },
                    "id": {
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "name",
                    "email",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success response",
          },
        },
        "summary": "Get user by ID",
        "tags": [
          "Users",
        ],
      },
    },
  },
  "tags": [
    {
      "name": "Doc Middleware",
    },
  ],
}
