{
  "name": "hono-docs",
  "version": "1.0.30",
  "description": "Auto-generate OpenAPI 3.0 spec from Hono route types",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/slawekkolodziej/hono-docs.git"
  },
  "bugs": {
    "url": "https://github.com/slawekkolodziej/hono-docs/issues"
  },
  "homepage": "https://github.com/slawekkolodziej/hono-docs#readme",
  "keywords": [
    "openapi",
    "hono",
    "typescript",
    "documentation",
    "cli",
    "generator"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "hono-docs": "dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs",
      "default": "./dist/core/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.mts",
      "import": "./dist/cli/index.mjs",
      "default": "./dist/cli/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"const fs=require('node:fs');const path=require('node:path');for(const dir of fs.readdirSync('integration',{withFileTypes:true})){if(dir.isDirectory())fs.rmSync(path.join('integration',dir.name,'openapi.json'),{force:true});}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:eslint": "eslint . --ext .ts,.tsx,.js",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run",
    "test.unit": "vitest run tests/unit",
    "test.integration": "vitest run tests/integration",
    "test.watch": "vitest tests/unit",
    "test.watch.all": "vitest",
    "test.coverage": "vitest run --coverage",
    "test.coverage.unit": "vitest run tests/unit --coverage",
    "test.coverage.open": "pnpm run test.coverage && open coverage/index.html",
    "test.coverage.ui": "vitest --coverage --ui",
    "site:build": "tsdown site/dev.ts --no-config --out-dir .site --clean --format esm --platform node --deps.never-bundle hono-docs",
    "dev": "pnpm build && pnpm run site:build && node .site/dev.mjs",
    "prepare": "husky install"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/valibot-validator": "workspace:*",
    "@hono/zod-validator": "workspace:*",
    "debug": "^4.4.3",
    "esbuild-register": "^3.6.0",
    "ts-morph": "^26.0.0",
    "tsx": "^4.21.0",
    "valibot": "^1.3.1",
    "yargs": "^18.0.0",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@scalar/hono-api-reference": "^0.10.7",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.3",
    "@types/yargs": "^17.0.33",
    "hono-docs": "link:.",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "hono": "4.12.26",
    "husky": "^8.0.3",
    "openapi-types": "^12.1.3",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "standard-version": "^9.5.0",
    "tsdown": "^0.21.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
